{
  "name": "droid-console",
  "version": "1.0.1",
  "private": true,
  "description": "DroidConsole - Multi-Device Android Management Desktop App",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cd web-frontend && npx vite build && cd .. && electron .",
    "build": "node scripts/build-win.js",
    "pack": "cd web-frontend && npx vite build && cd .. && electron-builder --dir",
    "web:build": "cd web-frontend && npx vite build",
    "setup": "npm install && cd desktop-host && npm install && cd ../web-frontend && npm install"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "localtunnel": "^2.0.2",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "uuid": "^13.0.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.droidconsole.app",
    "productName": "DroidConsole",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "desktop-host/src/**/*",
      "shared/**/*",
      "!desktop-host/node_modules",
      "!web-frontend",
      "!node_modules/electron",
      "!node_modules/electron-builder",
      "!node_modules/@electron"
    ],
    "extraResources": [
      {
        "from": "Icon.png",
        "to": "icon.png"
      },
      {
        "from": "desktop-host/vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "web-frontend/dist",
        "to": "web-frontend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "asar": true,
    "asarUnpack": [
      "desktop-host/vendor/**"
    ],
    "nodeGypRebuild": false
  }
}
